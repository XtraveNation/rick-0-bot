# Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_PATH=./data/jerry.db

# Path used by the Jerry SQLite persistence layer (backend/jerry/db.js).
# Defaults to backend/data/jerry.db if unset.
JERRY_DB_PATH=./data/jerry.db

# Payment Providers
PAYMENT_PROVIDER=coinbase
COINBASE_API_KEY=your_coinbase_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Shared secret used to verify Stripe webhook signatures
# (see https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Shared secret used to verify Coinbase Commerce webhook signatures
# (X-CC-Webhook-Signature header, see Coinbase Commerce dashboard)
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_shared_secret_here

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
EMBEDDING_PROVIDER=openai

# Embedding Providers (choose one)
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Authentication (placeholder - implement as needed)
JWT_SECRET=your_jwt_secret_here

# Logging level for backend/logger.js (error, warn, info, debug)
LOG_LEVEL=info
